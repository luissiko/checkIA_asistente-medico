{
    "hosting":  {
                    "ignore":  [
                                   "firebase.checkia.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "site":  "checkia-project",
                    "public":  "frontend/dist",
                    "headers":  [
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "X-Content-Type-Options",
                                                            "value":  "nosniff"
                                                        },
                                                        {
                                                            "key":  "Referrer-Policy",
                                                            "value":  "no-referrer"
                                                        },
                                                        {
                                                            "key":  "X-Frame-Options",
                                                            "value":  "DENY"
                                                        },
                                                        {
                                                            "key":  "Permissions-Policy",
                                                            "value":  "camera=(), microphone=(), geolocation=()"
                                                        }
                                                    ],
                                        "source":  "**"
                                    },
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "public,max-age=31536000,immutable"
                                                        }
                                                    ],
                                        "source":  "/assets/**"
                                    },
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache"
                                                        }
                                                    ],
                                        "source":  "/index.html"
                                    }
                                ],
                    "rewrites":  [
                                     {
                                         "run":  {
                                                     "region":  "us-central1",
                                                     "serviceId":  "checkia-api",
                                                     "pinTag":  true
                                                 },
                                         "source":  "/api/**"
                                     },
                                     {
                                         "destination":  "/index.html",
                                         "source":  "**"
                                     }
                                 ]
                }
}
